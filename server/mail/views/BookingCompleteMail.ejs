<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Odyra Safaris | Ride Completed</title>
</head>


<body style="margin:0; padding:0; width:100%; background-color:#f5f6f7; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color:#1f2933;">

    <!-- Preheader -->
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent;">
        Your Odyra Safaris journey has been completed. Here is your trip summary.
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:#f5f6f7;">
        <tr>
            <td align="center" style="padding:30px 16px;">

                <!-- Main Container -->
                <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background-color:#ffffff; border-radius:12px; overflow:hidden;">

                    <!-- Header -->
                    <tr>
                        <td style="padding:20px; border-bottom:1px solid #eeeeee;">
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                <tr>
                                    <td align="left">
                                                <img
                                                        src="https://cdn.odyra.com.au/assets/logo.png"
                                                        width="120"
                                                        alt="Odyra Safaris"
                                                        style="display:block; width:150px; max-width:150px; height:auto; border:0;"
                                                    >
                                    </td>

                                    <td align="right" style="font-size:12px;">
                                              <p style="font-weight: 500;display:inline-flex;border-radius: 5px;color:#333;background-color: rgb(195, 249, 226);align-items: center; justify-content: center;padding:10px 30px;">Ride Completed</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Hero -->
                    <tr>
                        <td style="padding:20px;">
                            <h1 style="margin:0 0 12px; font-size:28px; line-height:36px; font-weight:700; letter-spacing:-0.6px; color:#813020;">
                                Your journey is complete
                            </h1>

                            <p style="margin:0; font-size:15px; line-height:24px; color:#667085;">
                                Thank you for choosing Odyra Safaris. We hope you had a comfortable and enjoyable journey with us.
                            </p>
                        </td>
                    </tr>

                    <!-- Trip Summary -->
                    <tr>
                        <td style="padding:0 20px 20px;">

                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #e6e8eb; border-radius:10px; overflow:hidden;">

                                <!-- Summary Header -->
                                <tr>
                                    <td style="padding:18px 20px; background-color:#f8f9fa; border-bottom:1px solid #e6e8eb;">
                                        <span style="font-size:12px; font-weight:700; letter-spacing:0.8px; text-transform:uppercase; color:#667085;">
                                            Trip Summary
                                        </span>
                                    </td>
                                </tr>

                                <!-- Booking Reference -->
                                <tr>
                                    <td style="padding:20px 20px 8px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="font-size:13px; color:#8a9097;">
                                                    Booking Reference
                                                </td>
                                                <td align="right" style="font-size:13px; font-weight:600; color:#111827;">
                                                    <%= booking_id %>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Service -->
                                <tr>
                                    <td style="padding:8px 20px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="font-size:13px; color:#8a9097;">
                                                    Service
                                                </td>
                                                <td align="right" style="font-size:13px; font-weight:600; color:#111827;">
                                                    <%= rideType %> <%= service %>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Pickup -->
                                <tr>
                                    <td style="padding:8px 20px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="font-size:13px; color:#8a9097;">
                                                    Pickup
                                                </td>
                                                <td align="right" style="font-size:13px; font-weight:600; color:#111827;">
                                                    <%= pickup %>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Destination -->
                                <tr>
                                    <td style="padding:8px 20px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="font-size:13px; color:#8a9097;">
                                                    Destination
                                                </td>
                                                <td align="right" style="font-size:13px; font-weight:600; color:#111827;">
                                                    <%= dropoff %>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Date -->
                                <tr>
                                    <td style="padding:8px 20px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="font-size:13px; color:#8a9097;">
                                                    Date &amp; Time
                                                </td>
                                                <td align="right" style="font-size:13px; font-weight:600; color:#111827;">
                                                    <%= date %>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Duration -->
                                <tr>
                                    <td style="padding:8px 20px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="font-size:13px; color:#8a9097;">
                                                    Duration
                                                </td>
                                                <td align="right" style="font-size:13px; font-weight:600; color:#111827;">
                                                    <%= duration %>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                
                                <!-- Distance -->
                                <tr>
                                    <td style="padding:8px 20px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="font-size:13px; color:#8a9097;">
                                                    Ride Distance
                                                </td>
                                                <td align="right" style="font-size:13px; font-weight:600; color:#111827;">
                                                    <%= distance %>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Cost -->
                                <tr>
                                    <td style="padding:18px 20px; margin-top:8px; border-top:1px solid #e6e8eb;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                            <tr>
                                                <td style="font-size:14px; font-weight:600; color:#344054;">
                                                    Ride Cost
                                                </td>
                                                <td align="right" style="font-size:20px; font-weight:700; color:#111827;">
                                                    <%= rideCost %> AUD
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                            </table>

                        </td>
                    </tr>

                    <!-- Closing -->
                    <tr>
                        <td style="padding:0 40px 40px;">

                            <p style="margin:0 0 14px; font-size:14px; line-height:23px; color:#667085;">
                                Thank you for trusting Odyra Safaris. We look forward to serving you again on your next journey.
                            </p>

                            <p style="margin:0; font-size:14px; line-height:23px; color:#667085;">
                                Warm regards,<br>
                                <strong style="color:#111827;">The Odyra Safaris Team</strong>
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
